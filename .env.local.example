# Rename this file to exactly:  .env.local   (Next.js does NOT read .env.local.txt)
# Configure ONE of the two keys below, then restart `npm run dev`.
# NEVER commit this file or paste keys into chats/emails — rotate any key that leaks.

# Preferred — the takeoff prompts were tuned on Claude (console.anthropic.com):
ANTHROPIC_API_KEY=

# Or use OpenAI (the proxy auto-adapts the requests to gpt-4o vision):
OPENAI_API_KEY=

# Optional model overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
